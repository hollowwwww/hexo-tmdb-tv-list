<div class="tmdb-Tv-item"  data-src="https://www.themoviedb.org/t/p/w1920_and_h800_multi_faces<%= item.bg %>">
    <% if (flag === 0) { %>
        <div class="item-Tv-container" style="background-image: linear-gradient(to right, var(--gred-start) 150px, var(--gred-end) 100%);">
            <div class="tmdb-Tv-picture"><img class="no-lightbox" data-src="https://media.themoviedb.org/t/p/w600_and_h900_face<%= item.poster %>" src="" referrerPolicy="no-referrer" width="120"/></div>
            <div class="tmdb-Tv-info" style="text-align: right;">
                <div class="tmdb-Tv-title">
                    <a style="text-decoration: none;" target="self" href="https://www.themoviedb.org/movie/<%= item.id %>/"><%= item.title + " (" + item.origin_country + ")" %></a>
                </div>
                <div class="tmdb-Tv-meta">
                    <span class="tmdb-Tv-subtitle"><%= item.origin_title + " (" + item.date.slice(0, 4) + ") " %></span>
                    <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" class="ipc-icon ipc-icon--star-inline" viewBox="0 0 24 24" fill="#f5c518" role="presentation"><path d="M12 20.1l5.82 3.682c1.066.675 2.37-.322 2.09-1.584l-1.543-6.926 5.146-4.667c.94-.85.435-2.465-.799-2.567l-6.773-.602L13.29.89a1.38 1.38 0 0 0-2.581 0l-2.65 6.53-6.774.602C.052 8.126-.453 9.74.486 10.59l5.147 4.666-1.542 6.926c-.28 1.262 1.023 2.26 2.09 1.585L12 20.099z"></path></svg>
                    <span class="tmdb-Tv-vote"><%= item.vote_average %></span>
                    <% let genreStr = ""; %>
                    <% item.genres.forEach(function(genre) { %>
                    <% genreStr += genre.name + " "; %>
                    <% }); %>
                    <p class="tmdb-Tv-genres"><%= genreStr %></p>
                    <p class="tmdb-Tv-tagline"><%= item.tagline %></p>
                    <p class="tmdb-Tv-cast"><%= item.cast %></p>
                </div>
           </div>
        </div>
    <% } else { %>
        <div class="item-Tv-container" style="background-image: linear-gradient(to left, var(--gred-start) 150px, var(--gred-end) 100%);">
            <div class="tmdb-Tv-info" style="text-align: left;">
                <div class="tmdb-Tv-title">
                    <a style="text-decoration: none;" target="self" href="https://www.themoviedb.org/movie/<%= item.id %>/"><%= item.title + " (" + item.origin_country + ")" %></a>
                </div>
                <div class="tmdb-Tv-meta">
                    <span class="tmdb-Tv-subtitle"><%= item.origin_title + " (" + item.date.slice(0, 4) + ") " %></span>
                    <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" class="ipc-icon ipc-icon--star-inline" viewBox="0 0 24 24" fill="#f5c518" role="presentation"><path d="M12 20.1l5.82 3.682c1.066.675 2.37-.322 2.09-1.584l-1.543-6.926 5.146-4.667c.94-.85.435-2.465-.799-2.567l-6.773-.602L13.29.89a1.38 1.38 0 0 0-2.581 0l-2.65 6.53-6.774.602C.052 8.126-.453 9.74.486 10.59l5.147 4.666-1.542 6.926c-.28 1.262 1.023 2.26 2.09 1.585L12 20.099z"></path></svg>
                    <span class="tmdb-Tv-vote"><%= item.vote_average %></span>
                    <% let genreStr = ""; %>
                    <% item.genres.forEach(function(genre) { %>
                    <% genreStr += genre.name + " "; %>
                    <% }); %>
                    <p class="tmdb-Tv-genres"><%= genreStr %></p>
                    <p class="tmdb-Tv-tagline"><%= item.tagline %></p>
                    <p class="tmdb-Tv-cast"><%= item.cast %></p>
                </div>
            </div>
            <div class="tmdb-Tv-picture"><img class="no-lightbox" data-src="https://media.themoviedb.org/t/p/w600_and_h900_face<%= item.poster %>" src="" referrerPolicy="no-referrer" width="120"/></div>
        </div>
    <% } %>
</div>

